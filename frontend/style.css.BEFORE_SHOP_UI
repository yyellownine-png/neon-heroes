*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}

:root{
--bg:#05060c;
--panel:#101321;
--panel2:#151a2c;
--line:rgba(255,255,255,.09);
--text:#f7f8ff;
--muted:#858ca7;
--cyan:#00eaff;
--purple:#8b5cff;
--pink:#ff3d9a;
--green:#36f5a0;
--yellow:#ffd84d;
--red:#ff456e;
}

html,body{
margin:0;
padding:0;
min-height:100%;
background:
radial-gradient(circle at 50% -10%,rgba(0,234,255,.12),transparent 35%),
radial-gradient(circle at 100% 40%,rgba(139,92,255,.10),transparent 30%),
var(--bg);
color:var(--text);
font-family:Arial,Helvetica,sans-serif;
}

body{overflow-x:hidden}

button{
font:inherit;
color:inherit;
border:0;
outline:0;
cursor:pointer;
}

button:active{transform:scale(.98)}

#app{
min-height:100vh;
padding-bottom:88px;
}

.topbar{
position:sticky;
top:0;
z-index:100;
height:68px;
padding:8px 14px;
display:flex;
align-items:center;
justify-content:space-between;
background:rgba(5,6,12,.9);
border-bottom:1px solid var(--line);
backdrop-filter:blur(18px);
}

.logo{
display:flex;
flex-direction:column;
line-height:.82;
}

.logo span{
color:var(--cyan);
font-size:10px;
font-weight:900;
letter-spacing:2px;
}

.logo strong{
font-size:21px;
font-weight:1000;
letter-spacing:1px;
}

.resources{
display:flex;
gap:6px;
}

.resource{
min-width:68px;
height:32px;
padding:0 9px;
display:flex;
align-items:center;
justify-content:center;
gap:5px;
border:1px solid var(--line);
border-radius:11px;
background:linear-gradient(180deg,#181c2e,#0d101b);
font-size:11px;
}

.gem-icon{color:var(--cyan)}
.coin-icon{color:var(--yellow)}

#screen{
width:100%;
max-width:720px;
margin:auto;
padding:18px 13px 30px;
}

.page-title{
margin:4px 0 5px;
font-size:27px;
font-weight:1000;
letter-spacing:1px;
}

.page-subtitle{
margin:0 0 18px;
color:var(--muted);
font-size:11px;
line-height:1.5;
}

.hero-card{
position:relative;
min-height:330px;
overflow:hidden;
padding:23px 19px;
border:1px solid rgba(0,234,255,.18);
border-radius:27px;
background:
radial-gradient(circle at 78% 32%,rgba(0,234,255,.18),transparent 25%),
radial-gradient(circle at 100% 100%,rgba(139,92,255,.22),transparent 38%),
linear-gradient(135deg,#12172a,#080a12);
box-shadow:0 20px 60px rgba(0,0,0,.5);
}

.hero-card .tag{
display:inline-block;
padding:7px 10px;
border:1px solid rgba(0,234,255,.22);
border-radius:8px;
background:rgba(0,234,255,.06);
color:var(--cyan);
font-size:8px;
font-weight:1000;
letter-spacing:2px;
}

.hero-card h1{
position:relative;
z-index:5;
margin:17px 0 10px;
font-size:35px;
line-height:.92;
font-weight:1000;
}

.hero-card h1 span{
color:var(--cyan);
text-shadow:0 0 22px rgba(0,234,255,.4);
}

.hero-card p{
position:relative;
z-index:5;
width:54%;
margin:0 0 20px;
color:#a4aac0;
font-size:10px;
line-height:1.55;
}

.hero-symbol{
position:absolute;
right:-30px;
bottom:-25px;
width:60%;
filter:drop-shadow(0 20px 25px rgba(0,0,0,.65));
}

.hero-symbol svg{
width:100%;
height:auto;
}

.primary-btn{
min-height:49px;
padding:0 19px;
display:inline-flex;
align-items:center;
justify-content:center;
gap:7px;
border-radius:14px;
background:linear-gradient(135deg,#00eaff,#4d9cff);
color:#041018;
font-size:10px;
font-weight:1000;
letter-spacing:.8px;
box-shadow:0 9px 24px rgba(0,234,255,.18);
}

.stats{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:8px;
margin:11px 0;
}

.stat{
min-height:67px;
padding:10px 5px;
display:flex;
flex-direction:column;
align-items:center;
justify-content:center;
border:1px solid var(--line);
border-radius:16px;
background:linear-gradient(180deg,#121628,#0c0f1b);
}

.stat b{font-size:13px}
.stat small{
margin-top:4px;
color:var(--muted);
font-size:7px;
font-weight:900;
letter-spacing:1px;
}

.section-head{
display:flex;
align-items:center;
justify-content:space-between;
margin:21px 2px 10px;
}

.section-head h2{
margin:0;
font-size:15px;
font-weight:1000;
}

.section-head span{
color:var(--cyan);
font-size:8px;
font-weight:1000;
}

.quick-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:9px;
}

.quick-card{
min-height:92px;
padding:13px;
display:flex;
flex-direction:column;
align-items:flex-start;
justify-content:center;
text-align:left;
border:1px solid var(--line);
border-radius:17px;
background:linear-gradient(145deg,rgba(255,255,255,.045),transparent),#101321;
}

.quick-card .icon{
width:33px;
height:33px;
margin-bottom:8px;
display:flex;
align-items:center;
justify-content:center;
border-radius:10px;
background:linear-gradient(135deg,rgba(0,234,255,.13),rgba(139,92,255,.15));
color:var(--cyan);
font-size:13px;
font-weight:1000;
}

.quick-card b{font-size:9px}
.quick-card small{
margin-top:4px;
color:var(--muted);
font-size:8px;
}

.hero-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:10px;
}

.hero-item{
padding:0;
overflow:hidden;
text-align:left;
border:1px solid var(--line);
border-radius:19px;
background:linear-gradient(180deg,#15192a,#0d101b);
}

.hero-item.selected{
border-color:rgba(0,234,255,.65);
box-shadow:0 0 0 1px rgba(0,234,255,.12);
}

.hero-item-art{
position:relative;
height:180px;
overflow:hidden;
display:flex;
align-items:flex-end;
justify-content:center;
background:
radial-gradient(circle at 50% 30%,rgba(0,234,255,.13),transparent 50%),
#080a12;
}

.hero-item-art svg{
width:100%;
height:100%;
}

.hero-power{
position:absolute;
top:8px;
right:8px;
padding:6px 8px;
border:1px solid rgba(255,255,255,.08);
border-radius:8px;
background:rgba(5,7,13,.78);
color:var(--yellow);
font-size:8px;
font-weight:1000;
}

.hero-info{padding:10px}

.hero-info b{
display:block;
font-size:13px;
}

.rarity{
display:block;
margin-top:4px;
color:var(--cyan);
font-size:7px;
font-weight:1000;
letter-spacing:1px;
}

.hero-info small{
display:block;
margin-top:4px;
color:var(--muted);
font-size:8px;
}

.hero-select-line{
padding:8px 10px;
border-top:1px solid var(--line);
color:#68718a;
font-size:7px;
font-weight:1000;
}

.selected-hero{
min-height:245px;
display:flex;
overflow:hidden;
border:1px solid rgba(0,234,255,.18);
border-radius:23px;
background:
radial-gradient(circle at 20% 40%,rgba(0,234,255,.13),transparent 35%),
linear-gradient(135deg,#151a2d,#0a0d16);
}

.selected-art{
width:53%;
height:250px;
display:flex;
align-items:flex-end;
justify-content:center;
}

.selected-art svg{
width:100%;
height:100%;
}

.selected-info{
width:47%;
padding:20px 13px 15px 0;
}

.selected-info h2{
margin:7px 0 3px;
font-size:23px;
}

.selected-info p{
margin:0 0 17px;
color:var(--muted);
font-size:9px;
}

.power-line{
padding-top:9px;
display:flex;
align-items:center;
justify-content:space-between;
border-top:1px solid var(--line);
}

.power-line span{
color:var(--muted);
font-size:7px;
font-weight:1000;
}

.power-line strong{
color:var(--yellow);
font-size:15px;
}

.ability-box{
min-height:66px;
margin:11px 0;
padding:12px 14px;
display:flex;
flex-direction:column;
justify-content:center;
border:1px solid rgba(139,92,255,.25);
border-radius:16px;
background:linear-gradient(135deg,rgba(139,92,255,.11),rgba(0,234,255,.035));
}

.ability-box small{
color:var(--purple);
font-size:7px;
font-weight:1000;
}

.ability-box b{
margin-top:5px;
font-size:12px;
}

.chest-list{
display:flex;
flex-direction:column;
gap:9px;
}

.chest-card{
width:100%;
min-height:108px;
padding:11px;
display:flex;
align-items:center;
gap:12px;
text-align:left;
border:1px solid var(--line);
border-radius:19px;
background:linear-gradient(145deg,#15192a,#0c0f1b);
}

.chest-art{
width:76px;
height:76px;
flex:none;
display:flex;
align-items:center;
justify-content:center;
border-radius:17px;
background:radial-gradient(circle,rgba(139,92,255,.22),transparent 65%),#080a12;
}

.chest-art span{
font-size:37px;
color:var(--cyan);
}

.chest-info{
min-width:0;
flex:1;
}

.chest-rarity{
color:var(--purple);
font-size:7px;
font-weight:1000;
}

.chest-name{
display:block;
margin:5px 0;
font-size:13px;
font-weight:1000;
}

.chest-description{
color:var(--muted);
font-size:8px;
}

.chest-cost{
display:inline-block;
margin-top:6px;
color:var(--cyan);
font-size:8px;
font-weight:1000;
}

.chest-arrow{
color:#606982;
font-size:25px;
}

.profile-card{
padding:22px;
text-align:center;
border:1px solid rgba(139,92,255,.2);
border-radius:23px;
background:linear-gradient(145deg,#14182a,#0c0f1a);
}

.avatar{
width:76px;
height:76px;
margin:0 auto 12px;
display:flex;
align-items:center;
justify-content:center;
border:4px solid #090b13;
border-radius:50%;
background:linear-gradient(135deg,#00eaff,#8b5cff);
font-size:19px;
font-weight:1000;
}

.profile-card h2{margin:0;font-size:14px}
.profile-card>p{margin:6px 0 0;color:var(--muted);font-size:9px}

.profile-stats{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:5px;
margin-top:17px;
}

.profile-stat{
padding:9px 2px;
border-radius:11px;
background:rgba(255,255,255,.035);
}

.profile-stat b{display:block;font-size:9px}
.profile-stat small{
display:block;
margin-top:3px;
color:var(--muted);
font-size:6px;
}

.battle-arena{
min-height:310px;
padding:17px 7px;
display:grid;
grid-template-columns:1fr 48px 1fr;
align-items:center;
border:1px solid rgba(0,234,255,.14);
border-radius:24px;
overflow:hidden;
background:
radial-gradient(circle at 20% 50%,rgba(0,234,255,.14),transparent 32%),
radial-gradient(circle at 80% 50%,rgba(255,61,154,.13),transparent 32%),
linear-gradient(180deg,#101426,#080a12);
}

.battle-fighter{text-align:center}

.fighter-icon{
width:115px;
height:135px;
margin:auto;
display:flex;
align-items:flex-end;
justify-content:center;
}

.fighter-icon svg{
width:100%;
height:100%;
}

.battle-fighter b{
display:block;
font-size:10px;
}

.battle-fighter small{
display:block;
margin-top:3px;
color:var(--muted);
font-size:7px;
}

.vs{
width:43px;
height:43px;
display:flex;
align-items:center;
justify-content:center;
border-radius:50%;
background:linear-gradient(135deg,#ff3d9a,#8b5cff);
font-size:10px;
font-weight:1000;
}

.hp-bar{
height:7px;
margin:6px 3px 0;
overflow:hidden;
border-radius:20px;
background:#070911;
}

.hp-fill{
height:100%;
border-radius:20px;
background:linear-gradient(90deg,#27f49c,#b8ff5a);
}

.enemy-hp{
background:linear-gradient(90deg,#ff456e,#ff9b59);
}

.battle-log{
max-height:115px;
overflow:auto;
margin-top:9px;
padding:10px;
border:1px solid var(--line);
border-radius:14px;
background:#090c15;
}

.battle-log div{
padding:5px 0;
color:#9da5bd;
font-size:8px;
}

.battle-actions{
display:grid;
grid-template-columns:1fr 1fr;
gap:8px;
margin-top:9px;
}

.battle-actions .primary-btn{
width:100%;
font-size:8px;
}

.bottom-nav{
position:fixed;
z-index:150;
left:0;
right:0;
bottom:0;
height:78px;
padding:6px 7px;
display:grid;
grid-template-columns:1fr 1fr 68px 1fr 1fr;
gap:3px;
background:rgba(7,8,15,.96);
border-top:1px solid var(--line);
backdrop-filter:blur(20px);
}

.nav-btn{
display:flex;
flex-direction:column;
align-items:center;
justify-content:center;
gap:4px;
background:transparent;
color:#626a82;
}

.nav-btn span{font-size:20px}
.nav-btn small{font-size:7px;font-weight:900}
.nav-btn.active{color:var(--cyan)}

.nav-center{
width:58px;
height:58px;
align-self:center;
margin:auto;
display:flex;
align-items:center;
justify-content:center;
border-radius:19px;
background:linear-gradient(135deg,#00eaff,#8b5cff);
color:#061018;
font-size:24px;
box-shadow:0 8px 25px rgba(0,234,255,.22);
}

.modal-bg{
position:fixed;
inset:0;
z-index:300;
padding:18px;
display:flex;
align-items:center;
justify-content:center;
background:rgba(0,0,0,.78);
backdrop-filter:blur(10px);
}

.modal{
width:100%;
max-width:440px;
max-height:88vh;
overflow:auto;
padding:20px;
border:1px solid rgba(255,255,255,.11);
border-radius:23px;
background:#101321;
box-shadow:0 30px 90px rgba(0,0,0,.7);
}

.modal h2{
margin:0 0 5px;
font-size:21px;
}

.modal>p{
margin:0;
color:var(--muted);
font-size:9px;
}

.modal-actions{
margin-top:15px;
}

.modal-actions .primary-btn{
width:100%;
}

.game-modal{
position:fixed;
z-index:400;
inset:0;
display:flex;
align-items:flex-end;
justify-content:center;
}

.game-modal-backdrop{
position:absolute;
inset:0;
background:rgba(0,0,0,.8);
backdrop-filter:blur(12px);
}

.settings-panel{
position:relative;
z-index:2;
width:100%;
max-width:600px;
padding:20px 15px;
border-radius:27px 27px 0 0;
background:#0d101b;
box-shadow:0 -20px 70px rgba(0,0,0,.6);
}

.settings-header{
display:flex;
align-items:center;
justify-content:space-between;
margin-bottom:19px;
}

.settings-header small{
color:var(--cyan);
font-size:7px;
font-weight:1000;
letter-spacing:2px;
}

.settings-header h2{
margin:5px 0 0;
font-size:24px;
}

.modal-close{
width:40px;
height:40px;
border:1px solid var(--line);
border-radius:12px;
background:#171b2b;
font-size:22px;
}

.settings-section-title{
margin:16px 3px 8px;
color:#626b87;
font-size:7px;
font-weight:1000;
}

.setting-row{
width:100%;
min-height:65px;
padding:10px 11px;
display:grid;
grid-template-columns:38px 1fr auto;
align-items:center;
gap:9px;
text-align:left;
background:#121625;
border:1px solid var(--line);
color:#fff;
}

.setting-icon{
width:33px;
height:33px;
display:flex;
align-items:center;
justify-content:center;
border-radius:10px;
background:rgba(0,234,255,.08);
color:var(--cyan);
}

.setting-row b{display:block;font-size:10px}
.setting-row small{
display:block;
margin-top:3px;
color:var(--muted);
font-size:7px;
}

.setting-toggle{
min-width:41px;
padding:6px;
text-align:center;
border-radius:8px;
background:#202436;
color:#737b92;
font-size:7px;
font-weight:1000;
}

.setting-toggle.on{
color:var(--green);
background:rgba(54,245,160,.11);
}

.settings-account{
min-height:67px;
padding:11px;
display:flex;
align-items:center;
gap:11px;
border:1px solid var(--line);
border-radius:15px;
background:#121625;
}

.settings-avatar{
width:43px;
height:43px;
display:flex;
align-items:center;
justify-content:center;
border-radius:50%;
background:linear-gradient(135deg,#00eaff,#8b5cff);
font-size:10px;
font-weight:1000;
}

.settings-account b{display:block;font-size:9px}
.settings-account small{
display:block;
margin-top:3px;
color:var(--muted);
font-size:6px;
}

.settings-version{
display:flex;
justify-content:space-between;
margin-top:13px;
padding:10px 2px;
color:#656d85;
font-size:7px;
}

.embedded-hero-art{
display:flex;
align-items:center;
justify-content:center;
overflow:hidden;
}

.embedded-hero-art svg{
display:block;
max-width:100%;
max-height:100%;
}

::-webkit-scrollbar{width:3px}
::-webkit-scrollbar-thumb{
background:#282e43;
border-radius:10px;
}

@media(max-width:380px){
.hero-card{min-height:310px}
.hero-card h1{font-size:31px}
.hero-item-art{height:165px}
.selected-art{height:230px}
.selected-info h2{font-size:20px}
.fighter-icon{width:100px;height:120px}
}

@media(min-width:700px){
#screen{padding-top:25px}
.hero-grid{grid-template-columns:repeat(4,1fr)}
.quick-grid{grid-template-columns:repeat(4,1fr)}
.hero-card{min-height:390px}
.hero-card h1{font-size:47px}
.hero-symbol{width:43%}
}

/* LEADERBOARD */

.leaderboard{
    margin-top:16px;
    display:flex;
    flex-direction:column;
    gap:7px;
}

.rank{
    min-height:62px;
    padding:8px 10px;
    display:flex;
    align-items:center;
    gap:10px;
    border:1px solid rgba(255,255,255,.07);
    border-radius:14px;
    background:linear-gradient(135deg,#15192a,#0c0f19);
}

.rank-info{
    flex:1;
    min-width:0;
}

.rank-info b{
    display:block;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
    font-size:10px;
}

.rank-info small{
    display:block;
    margin-top:3px;
    color:#626a82;
    font-size:6px;
    letter-spacing:1px;
}

.rank>strong{
    color:#ffd84d;
    font-size:10px;
}

.player-avatar{
    width:42px;
    height:42px;
    flex:none;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    background:
        linear-gradient(135deg,var(--avatar-a),var(--avatar-b));
    box-shadow:
        0 0 0 3px rgba(255,255,255,.04),
        0 5px 15px rgba(0,0,0,.35);
}

.player-avatar span{
    color:#fff;
    font-size:10px;
    font-weight:1000;
}

/* TOAST */

.game-toast{
    position:fixed;
    z-index:999;
    left:50%;
    bottom:92px;
    transform:translateX(-50%);
    max-width:calc(100% - 30px);
    padding:12px 17px;
    border:1px solid rgba(0,234,255,.3);
    border-radius:13px;
    background:rgba(10,14,25,.96);
    color:#fff;
    box-shadow:0 12px 35px rgba(0,0,0,.5);
    font-size:9px;
    font-weight:900;
    text-align:center;
    transition:.3s ease;
}

.game-toast.hide{
    opacity:0;
    transform:translate(-50%,10px);
}

/* POWER ICON SVG */

.quick-card .icon svg{
    width:25px;
    height:25px;
}


/* =========================
   LANGUAGE SELECTOR
========================= */

.language-selector {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0 0 18px;
}

.language-option {
    width: 100%;
    min-height: 62px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 14px;
    background: rgba(255,255,255,.035);
    color: #fff;
    text-align: left;
    cursor: pointer;
    transition: .18s ease;
}

.language-option:active {
    transform: scale(.98);
}

.language-option.selected {
    border-color: rgba(70,220,255,.75);
    background: rgba(70,220,255,.09);
    box-shadow:
        0 0 0 1px rgba(70,220,255,.12),
        0 0 20px rgba(70,220,255,.08);
}

.language-flag {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    font-size: 23px;
    flex: 0 0 34px;
}

.language-option > span:nth-child(2) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.language-option b {
    font-size: 14px;
    letter-spacing: .3px;
}

.language-option small {
    color: rgba(255,255,255,.48);
    font-size: 11px;
}

.language-check {
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.16);
    color: #55e8ff;
    font-weight: 800;
}

.language-option.selected .language-check {
    border-color: #55e8ff;
    background: rgba(85,232,255,.12);
}

/* =========================================================
   NEON HEROES — GAME ANIMATIONS
   ========================================================= */

button,
.btn,
.game-btn,
.nav-btn,
.hero-card,
.menu-card,
.chest-card,
.power-card,
[onclick] {
    -webkit-tap-highlight-color: transparent;
    transition:
        transform .14s ease,
        filter .18s ease,
        box-shadow .18s ease,
        opacity .18s ease;
}

button:hover,
.btn:hover,
.game-btn:hover,
.menu-card:hover,
.hero-card:hover,
.chest-card:hover,
.power-card:hover {
    transform: translateY(-2px);
    filter: brightness(1.12);
}

.neon-pressed {
    transform: scale(.94) !important;
    filter: brightness(1.3) !important;
}

.menu-card,
.hero-card,
.chest-card,
.power-card {
    animation: neonCardIn .42s ease both;
}

@keyframes neonCardIn {
    from {
        opacity: 0;
        transform: translateY(12px) scale(.97);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.menu-card:nth-child(2),
.hero-card:nth-child(2),
.chest-card:nth-child(2),
.power-card:nth-child(2) {
    animation-delay: .05s;
}

.menu-card:nth-child(3),
.hero-card:nth-child(3),
.chest-card:nth-child(3),
.power-card:nth-child(3) {
    animation-delay: .1s;
}

.menu-card:nth-child(4),
.hero-card:nth-child(4),
.chest-card:nth-child(4),
.power-card:nth-child(4) {
    animation-delay: .15s;
}

.game-btn,
.btn {
    position: relative;
    overflow: hidden;
}

.game-btn::after,
.btn::after {
    content: "";
    position: absolute;
    top: 0;
    left: -120%;
    width: 70%;
    height: 100%;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,.18),
        transparent
    );
    transform: skewX(-20deg);
    transition: left .45s ease;
    pointer-events: none;
}

.game-btn:hover::after,
.btn:hover::after {
    left: 140%;
}

.nav-btn {
    position: relative;
}

.nav-btn.active::before {
    content: "";
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: -2px;
    height: 3px;
    border-radius: 99px;
    box-shadow: 0 0 8px currentColor;
    animation: navGlow 1.4s ease-in-out infinite alternate;
}

@keyframes navGlow {
    from {
        opacity: .45;
        transform: scaleX(.75);
    }

    to {
        opacity: 1;
        transform: scaleX(1);
    }
}

.hero-card:hover {
    box-shadow:
        0 0 20px rgba(0, 220, 255, .16),
        0 12px 30px rgba(0,0,0,.28);
}

.chest-card:hover {
    box-shadow:
        0 0 24px rgba(255, 196, 70, .18),
        0 12px 30px rgba(0,0,0,.28);
}

.power-card:hover {
    box-shadow:
        0 0 24px rgba(170, 80, 255, .18),
        0 12px 30px rgba(0,0,0,.28);
}

.menu-card:hover {
    box-shadow:
        0 0 24px rgba(0, 220, 255, .14),
        0 10px 28px rgba(0,0,0,.28);
}

@keyframes energyPulse {
    from {
        opacity: .65;
        transform: scale(.98);
    }

    to {
        opacity: 1;
        transform: scale(1.02);
    }
}

.resource,
.resource-item {
    animation: energyPulse 2s ease-in-out infinite alternate;
}

