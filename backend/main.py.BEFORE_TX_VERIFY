def create_payment_order(uid, network, gram_amount):

    ensure_user(uid)

    network = str(network).upper()
    gram_amount = int(gram_amount)

    if network not in PAYMENT_ADDRESSES:
        return {"error": "Unsupported payment network"}

    package = GRAM_PACKAGES.get(gram_amount)

    if not package:
        return {"error": "Invalid GRAM package"}

    payment_amount = package[
        "ton" if network == "TON" else "usdt"
    ]

    c = db()

    now = int(time.time())

    c.execute(
        """
        INSERT INTO payment_orders(
            uid,
            network,
            gram_amount,
            payment_amount,
            address,
            status,
            created_at
        )
        VALUES(?,?,?,?,?,?,?)
        """,
        (
            uid,
            network,
            gram_amount,
            payment_amount,
            PAYMENT_ADDRESSES[network],
            "PENDING",
            now
        )
    )

    order_id = c.execute(
        "SELECT last_insert_rowid()"
    ).fetchone()[0]

    c.commit()
    c.close()

    return {
        "success": True,
        "order_id": order_id,
        "network": network,
        "gram": gram_amount,
        "amount": payment_amount,
        "address": PAYMENT_ADDRESSES[network],
        "status": "PENDING"
    }


