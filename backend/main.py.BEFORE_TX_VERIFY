def confirm_payment(order_id, tx_hash):

    """
    Внутренняя функция.
    НЕ вызывается клиентом напрямую.

    В будущем сюда передаём только транзакцию,
    которую backend уже проверил в блокчейне.
    """

    tx_hash = str(tx_hash).strip()

    if not tx_hash:
        return {"error": "Missing transaction hash"}

    c = db()

    try:
        c.execute("BEGIN IMMEDIATE")

        order = c.execute(
            """
            SELECT *
            FROM payment_orders
            WHERE id=?
            """,
            (order_id,)
        ).fetchone()

        if not order:
            c.rollback()
            return {"error": "Order not found"}

        if order["status"] == "PAID":
            c.rollback()
            return {
                "success": True,
                "status": "PAID",
                "already_processed": True
            }

        # Одна транзакция не может быть использована дважды.
        used = c.execute(
            """
            SELECT id
            FROM payment_orders
            WHERE tx_hash=? AND status='PAID'
            LIMIT 1
            """,
            (tx_hash,)
        ).fetchone()

        if used:
            c.rollback()
            return {
                "error": "Transaction already used"
            }

        user = c.execute(
            "SELECT gram FROM users WHERE uid=?",
            (order["uid"],)
        ).fetchone()

        if not user:
            c.rollback()
            return {"error": "User not found"}

        new_gram = (
            int(user["gram"] or 0)
            + int(order["gram_amount"])
        )

        now = int(time.time())

        c.execute(
            """
            UPDATE users
            SET gram=?
            WHERE uid=?
            """,
            (new_gram, order["uid"])
        )

        c.execute(
            """
            UPDATE payment_orders
            SET tx_hash=?,
                status='PAID',
                paid_at=?
            WHERE id=?
            """,
            (tx_hash, now, order_id)
        )

        c.commit()

        return {
            "success": True,
            "status": "PAID",
            "gram": new_gram
        }

    except Exception as e:
        c.rollback()
        return {
            "error": str(e)
        }

    finally:
        c.close()


