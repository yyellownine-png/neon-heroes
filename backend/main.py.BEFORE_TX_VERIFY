def db():
    c = sqlite3.connect(DB)
    c.row_factory = sqlite3.Row

    c.execute("""
        CREATE TABLE IF NOT EXISTS users (
            uid INTEGER PRIMARY KEY,
            gems INTEGER DEFAULT 100,
            coins INTEGER DEFAULT 5000,
            energy INTEGER DEFAULT 30,
            level INTEGER DEFAULT 1,
            xp INTEGER DEFAULT 0,
            gram INTEGER DEFAULT 0,
            chest_tickets INTEGER DEFAULT 0,
            hero_fragments INTEGER DEFAULT 0,
            energy_updated INTEGER DEFAULT 0,
            energy_purchases_today INTEGER DEFAULT 0,
            energy_purchase_day TEXT DEFAULT ''
        )
    """)

    for column, definition in [
        ("gram", "INTEGER DEFAULT 0"),
        ("chest_tickets", "INTEGER DEFAULT 0"),
        ("hero_fragments", "INTEGER DEFAULT 0"),
        ("energy_updated", "INTEGER DEFAULT 0"),
        ("energy_purchases_today", "INTEGER DEFAULT 0"),
        ("energy_purchase_day", "TEXT DEFAULT ''")
    ]:
        try:
            c.execute(f"ALTER TABLE users ADD COLUMN {column} {definition}")
        except sqlite3.OperationalError:
            pass

    c.execute("""
        CREATE TABLE IF NOT EXISTS shop_purchases (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            uid INTEGER NOT NULL,
            product_id TEXT NOT NULL,
            gram_spent INTEGER NOT NULL,
            created_at INTEGER NOT NULL
        )
    """)

    c.execute("""
        CREATE TABLE IF NOT EXISTS payment_orders (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            uid INTEGER NOT NULL,
            network TEXT NOT NULL,
            gram_amount INTEGER NOT NULL,
            payment_amount TEXT NOT NULL,
            address TEXT NOT NULL,
            tx_hash TEXT DEFAULT '',
            status TEXT DEFAULT 'PENDING',
            created_at INTEGER NOT NULL,
            paid_at INTEGER DEFAULT 0
        )
    """)

    c.execute("""
        CREATE TABLE IF NOT EXISTS collection (
            uid INTEGER,
            hero_id INTEGER,
            count INTEGER DEFAULT 1,
            PRIMARY KEY(uid, hero_id)
        )
    """)

    c.commit()
    return c


def ensure_user(uid):
    c = db()

    user = c.execute(
        "SELECT * FROM users WHERE uid=?",
        (uid,)
    ).fetchone()

    if not user:
        now = int(time.time())
        c.execute("""
            INSERT INTO users(
                uid,gems,coins,energy,level,xp,gram,
                chest_tickets,hero_fragments,energy_updated
            )
            VALUES(?,?,?,?,?,?,?,?,?,?)
        """, (
            uid, 100, 5000, 30, 1, 0, 0,
            0, 0, now
        ))
        c.commit()

    c.close()


def get_state(uid):
    ensure_user(uid)

    # Passive Energy regeneration.
    restore_energy(uid)

    c = db()

    user = c.execute(
        "SELECT * FROM users WHERE uid=?",
        (uid,)
    ).fetchone()

    collection = c.execute(
        "SELECT hero_id,count FROM collection WHERE uid=?",
        (uid,)
    ).fetchall()

    owned = []

    for row in collection:
        owned.append({
            "hero_id": row["hero_id"],
            "count": row["count"]
        })

    result = {
        "uid": uid,
        "gems": user["gems"],
        "coins": user["coins"],
        "energy": user["energy"],
        "max_energy": 30,
        "gram": user["gram"],
        "chest_tickets": user["chest_tickets"],
        "hero_fragments": user["hero_fragments"],
        "energy_updated": user["energy_updated"],
        "level": user["level"],
        "xp": user["xp"],
        "owned": owned
    }

    c.close()

    return result


def open_chest(uid, chest):
    if chest not in CHESTS:
        return {"error": "Unknown chest"}

    ensure_user(uid)

    cost = CHESTS[chest]

    c = db()

    user = c.execute(
        "SELECT gems FROM users WHERE uid=?",
        (uid,)
    ).fetchone()

    gems = user["gems"]

    if gems < cost:
        c.close()
        return {"error": "Not enough gems"}

    odds = {
        "Basic": ["Common", "Common", "Rare"],
        "Rare": ["Common", "Rare", "Rare", "Epic"],
        "Epic": ["Rare", "Epic", "Epic", "Legendary"],
        "Legendary": ["Epic", "Legendary", "Legendary", "Limited Legendary"]
    }

    rarity = random.choice(odds[chest])

    pool = [
        h for h in HEROES
        if h["rarity"] == rarity
    ]

    if not pool:
        pool = [
            h for h in HEROES
            if h["rarity"] == "Legendary"
        ]

    hero = random.choice(pool)

    new_gems = gems - cost

    c.execute(
        "UPDATE users SET gems=? WHERE uid=?",
        (new_gems, uid)
    )

    old = c.execute("""
        SELECT count
        FROM collection
        WHERE uid=? AND hero_id=?
    """, (uid, hero["id"])).fetchone()

    if old:
        c.execute("""
            UPDATE collection
            SET count=count+1
            WHERE uid=? AND hero_id=?
        """, (uid, hero["id"]))
    else:
        c.execute("""
            INSERT INTO collection(uid,hero_id,count)
            VALUES(?,?,1)
        """, (uid, hero["id"], 1))

    c.commit()
    c.close()

    return {
        "hero": hero,
        "rarity": rarity,
        "gems": new_gems
    }



