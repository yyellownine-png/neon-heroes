    c = db()

    user = c.execute(
        "SELECT * FROM users WHERE uid=?",
        (uid,)
    ).fetchone()

    energy = user["energy"]

    # Energy: максимум 30, стоимость обычного боя — 3
    if energy < 3:
        c.close()
        return {"error": "Not enough energy"}

    enemy_power = 900 + mission * 420

    owned_power = 0

    rows = c.execute("""
        SELECT hero_id,count
        FROM collection
        WHERE uid=?
    """, (uid,)).fetchall()

    for row in rows:
        hero = next(
            (h for h in HEROES if h["id"] == row["hero_id"]),
            None
        )

        if hero:
            owned_power += hero["power"] * row["count"]

    if owned_power == 0:
        owned_power = 1000

    win_chance = min(
        0.9,
        max(
            0.25,
            0.5 + (owned_power - enemy_power) / 10000
        )
    )

    win = random.random() < win_chance

    if win:
        coins_reward = 250 + mission * 75
        gems_reward = 2 + mission // 2
        xp_reward = 100 + mission * 25
    else:
        coins_reward = 50
        gems_reward = 0
        xp_reward = 25

    new_energy = max(0, energy - 3)
    new_coins = user["coins"] + coins_reward
    new_gems = user["gems"] + gems_reward
    new_xp = user["xp"] + xp_reward

    level = user["level"]

    if new_xp >= level * 500:
        new_xp -= level * 500
        level += 1

    c.execute("""
        UPDATE users
        SET energy=?,coins=?,gems=?,xp=?,level=?,energy_updated=?
        WHERE uid=?
    """, (
        new_energy,
        new_coins,
        new_gems,
        new_xp,
        level,
        int(time.time()),
        uid
    ))

    c.commit()
    c.close()

    return {
        "win": win,
        "reward": {
            "coins": coins_reward,
            "gems": gems_reward,
            "xp": xp_reward
        }
    }


def leaderboard():
    c = db()

    rows = c.execute("""
        SELECT uid,coins,level
        FROM users
        ORDER BY coins DESC
        LIMIT 50
    """).fetchall()

    result = []

    for row in rows:
        result.append({
            "uid": row["uid"],
            "coins": row["coins"],
            "level": row["level"]
        })

    c.close()

    return result


class Handler(BaseHTTPRequestHandler):

    def send_json(self, data, status=200):
        body = json.dumps(
            data,
            ensure_ascii=False
        ).encode("utf-8")

        self.send_response(status)
        self.send_header(
            "Content-Type",
            "application/json; charset=utf-8"
        )
        self.send_header(
            "Access-Control-Allow-Origin",
            "*"
        )
        self.send_header(
            "Access-Control-Allow-Methods",
            "GET, POST, OPTIONS"
        )
        self.send_header(
            "Access-Control-Allow-Headers",
            "Content-Type"
        )
        self.send_header(
            "Content-Length",
            str(len(body))
        )
        self.end_headers()

        self.wfile.write(body)

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header(
            "Access-Control-Allow-Origin",
            "*"
        )
        self.send_header(
            "Access-Control-Allow-Methods",
            "GET, POST, OPTIONS"
        )
        self.send_header(
            "Access-Control-Allow-Headers",
            "Content-Type"
        )
        self.end_headers()

    def read_json(self):
        try:
            length = int(
                self.headers.get(
                    "Content-Length",
                    0
                )
            )

            raw = self.rfile.read(length)

            return json.loads(
                raw.decode("utf-8")
            )

        except Exception:
            return {}

    def do_GET(self):
        path = urlparse(self.path).path.rstrip("/")

        if path == "/api/heroes":
            self.send_json(HEROES)
            return

        if path == "/api/shop":
            self.send_json({
                "products": get_shop()
            })
            return

        if path == "/api/payment/packages":
            self.send_json({
                "packages": [
                    {
                        "gram": amount,
                        "ton": data["ton"],
                        "usdt": data["usdt"]
                    }
                    for amount, data in GRAM_PACKAGES.items()
                ],
                "addresses": PAYMENT_ADDRESSES
            })
            return

        if path.startswith("/api/state/"):
            try:
                uid = int(
                    path.split("/")[-1]
                )

                self.send_json(
                    get_state(uid)
                )

            except Exception as e:
                self.send_json(
                    {"error": str(e)},
                    400
                )

            return

        if path == "/api/leaderboard":
            self.send_json(
                leaderboard()
            )
            return

        if path == "":
            self.send_json({
                "status": "online",
                "name": "Neon Heroes API"
            })
            return

        self.send_json(
            {"error": "Not found"},
            404
        )

    def do_POST(self):
        path = urlparse(self.path).path.rstrip("/")

        data = self.read_json()

        if path == "/api/payment/create":
            try:
                data = json.loads(
                    self.rfile.read(
                        int(self.headers.get("Content-Length", 0))
                    ).decode("utf-8")
                )

                uid = int(data.get("uid"))
                network = str(data.get("network"))
                gram = int(data.get("gram"))

                result = create_payment_order(
                    uid,
                    network,
                    gram
                )

                self.send_json(
                    result,
                    400 if "error" in result else 200
                )

            except Exception as e:
                self.send_json({
                    "error": str(e)
                }, 400)

            return

        if path == "/api/payment/status":
            try:
                data = json.loads(
                    self.rfile.read(
                        int(self.headers.get("Content-Length", 0))
                    ).decode("utf-8")
                )

                uid = int(data.get("uid"))
                order_id = int(data.get("order_id"))

                result = get_payment_order(
                    uid,
                    order_id
                )

                self.send_json(
                    result,
                    400 if "error" in result else 200
                )

            except Exception as e:
                self.send_json({
                    "error": str(e)
                }, 400)

            return

        if path == "/api/shop/purchase":
            try:
                data = json.loads(
                    self.rfile.read(
                        int(self.headers.get("Content-Length", 0))
                    ).decode("utf-8")
                )

                uid = int(data.get("uid"))
                product_id = str(data.get("product_id"))

                result = purchase_product(
                    uid,
                    product_id
                )

                if "error" in result:
                    self.send_json(
                        result,
                        400
                    )
                else:
                    self.send_json(result)

            except Exception as e:
                self.send_json({
                    "error": str(e)
                }, 400)

            return

        if path == "/api/chest/open":
            try:
                uid = int(data["uid"])
                chest = str(data["chest"])

                result = open_chest(
                    uid,
                    chest
                )

                if "error" in result:
                    self.send_json(
                        result,
                        400
                    )
                else:
                    self.send_json(result)

            except Exception as e:
                self.send_json(
                    {"error": str(e)},
                    400
                )

            return

        if path == "/api/battle":
            try:
                uid = int(data["uid"])
                mission = int(
                    data.get("mission", 1)
                )

                result = do_battle(
                    uid,
                    mission
                )

                if "error" in result:
                    self.send_json(
                        result,
                        400
                    )
                else:
                    self.send_json(result)

            except Exception as e:
                self.send_json(
                    {"error": str(e)},
                    400
                )

            return

        self.send_json(
            {"error": "Not found"},
            404
        )


def main():
    host = "0.0.0.0"
    port = 8000

    print("")
    print("==============================")
    print("       NEON HEROES API")
    print("==============================")
    print(f"Server: http://127.0.0.1:{port}")
    print("Status: ONLINE")
    print("Press CTRL+C to stop")
    print("==============================")
    print("")

    server = ThreadingHTTPServer(
        (host, port),
        Handler
    )

    try:
        server.serve_forever()

    except KeyboardInterrupt:
        print("\nServer stopped.")

    finally:
        server.server_close()


