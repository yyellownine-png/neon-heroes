def restore_energy(uid):
    """
    Passive regeneration:
    +1 Energy every 6 minutes.
    Maximum = 30.
    """
    ensure_user(uid)

    c = db()

    user = c.execute(
        "SELECT energy, energy_updated FROM users WHERE uid=?",
        (uid,)
    ).fetchone()

    if not user:
        c.close()
        return 0

    now = int(time.time())
    current = int(user["energy"] or 0)
    updated = int(user["energy_updated"] or now)

    if updated <= 0:
        updated = now

    elapsed = max(0, now - updated)
    restored = elapsed // 360

    if restored > 0 and current < 30:
        new_energy = min(30, current + restored)

        # If energy became full, timestamp becomes now.
        # Otherwise preserve the remainder of the 6-minute timer.
        if new_energy >= 30:
            new_updated = now
        else:
            new_updated = updated + restored * 360

        c.execute(
            """
            UPDATE users
            SET energy=?, energy_updated=?
            WHERE uid=?
            """,
            (new_energy, new_updated, uid)
        )

        c.commit()
        current = new_energy

    elif current >= 30:
        c.execute(
            "UPDATE users SET energy_updated=? WHERE uid=?",
            (now, uid)
        )
        c.commit()

    c.close()

    return current


def purchase_product(uid, product_id):
    """
    Server-authoritative in-game purchase.
    GRAM is consumed first and the reward is granted
    inside the same SQLite transaction.
    """

    ensure_user(uid)

    product = SHOP_PRODUCTS.get(product_id)

    if not product:
        return {"error": "Unknown product"}

    c = db()

    try:
        c.execute("BEGIN IMMEDIATE")

        user = c.execute(
            "SELECT * FROM users WHERE uid=?",
            (uid,)
        ).fetchone()

        if not user:
            c.rollback()
            return {"error": "User not found"}

        gram = int(user["gram"] or 0)
        price = int(product["gram"])

        if gram < price:
            c.rollback()
            return {
                "error": "Not enough GRAM",
                "gram": gram,
                "required": price
            }

        # Always calculate current Energy before purchase.
        energy = restore_energy(uid)

        # restore_energy opens its own DB connection, so refresh user.
        user = c.execute(
            "SELECT * FROM users WHERE uid=?",
            (uid,)
        ).fetchone()

        gram = int(user["gram"] or 0)
        new_gram = gram - price

        # ==================================
        # GEMS
        # ==================================
        if product["type"] == "gems":
            new_gems = int(user["gems"] or 0) + product["amount"]

            c.execute(
                "UPDATE users SET gram=?, gems=? WHERE uid=?",
                (new_gram, new_gems, uid)
            )

            reward = {
                "gems": product["amount"]
            }

        # ==================================
        # ENERGY
        # ==================================
        elif product["type"] == "energy":
            new_energy = min(
                30,
                int(user["energy"] or 0) + product["amount"]
            )

            c.execute(
                """
                UPDATE users
                SET gram=?, energy=?, energy_updated=?
                WHERE uid=?
                """,
                (new_gram, new_energy, int(time.time()), uid)
            )

            reward = {
                "energy": new_energy
            }

        elif product["type"] == "energy_full":
            c.execute(
                """
                UPDATE users
                SET gram=?, energy=30, energy_updated=?
                WHERE uid=?
                """,
                (new_gram, int(time.time()), uid)
            )

            reward = {
                "energy": 30
            }

        # ==================================
        # CHEST
        # ==================================
        elif product["type"] == "chest":
            chest = product["chest"]

            odds = {
                "Basic": ["Common", "Common", "Rare"],
                "Rare": ["Common", "Rare", "Rare", "Epic"],
                "Epic": ["Rare", "Epic", "Epic", "Legendary"],
                "Legendary": [
                    "Epic",
                    "Legendary",
                    "Legendary",
                    "Limited Legendary"
                ]
            }

            rarity = random.choice(odds[chest])

            pool = [
                h for h in HEROES
                if h["rarity"] == rarity
            ]

            if not pool:
                pool = [
                    h for h in HEROES
                    if h["rarity"] == "Legendary"
                ]

            hero = random.choice(pool)

            old = c.execute(
                """
                SELECT count FROM collection
                WHERE uid=? AND hero_id=?
                """,
                (uid, hero["id"])
            ).fetchone()

            if old:
                c.execute(
                    """
                    UPDATE collection
                    SET count=count+1
                    WHERE uid=? AND hero_id=?
                    """,
                    (uid, hero["id"])
                )
            else:
                c.execute(
                    """
                    INSERT INTO collection(uid,hero_id,count)
                    VALUES(?,?,1)
                    """,
                    (uid, hero["id"], 1)
                )

            c.execute(
                "UPDATE users SET gram=? WHERE uid=?",
                (new_gram, uid)
            )

            reward = {
                "hero": hero,
                "rarity": rarity,
                "chest": chest
            }

        # ==================================
        # STARTER
        # ==================================
        elif product["type"] == "starter":
            # One-time purchase check.
            marker = c.execute(
                """
                SELECT 1 FROM shop_purchases
                WHERE uid=? AND product_id='starter'
                LIMIT 1
                """,
                (uid,)
            ).fetchone()

            if marker:
                c.rollback()
                return {"error": "Starter pack already purchased"}

            c.execute(
                """
                UPDATE users
                SET gram=?,
                    gems=gems+500,
                    coins=coins+5000,
                    energy=30,
                    energy_updated=?
                WHERE uid=?
                """,
                (new_gram, int(time.time()), uid)
            )

            reward = {
                "gems": 500,
                "coins": 5000,
                "energy": 30
            }

        # ==================================
        # WEEKLY
        # ==================================
        elif product["type"] == "weekly":
            c.execute(
                """
                UPDATE users
                SET gram=?,
                    gems=gems+1500,
                    coins=coins+15000,
                    energy=30,
                    energy_updated=?
                WHERE uid=?
                """,
                (new_gram, int(time.time()), uid)
            )

            reward = {
                "gems": 1500,
                "coins": 15000,
                "energy": 30
            }

        # ==================================
        # PREMIUM PASS
        # ==================================
        elif product["type"] == "pass":
            c.execute(
                """
                UPDATE users
                SET gram=?,
                    gems=gems+3000,
                    coins=coins+30000,
                    energy=30,
                    energy_updated=?
                WHERE uid=?
                """,
                (new_gram, int(time.time()), uid)
            )

            reward = {
                "gems": 3000,
                "coins": 30000,
                "energy": 30,
                "premium_pass": True
            }

        # ==================================
        # SEASON PACK
        # ==================================
        elif product["type"] == "season":
            c.execute(
                """
                UPDATE users
                SET gram=?,
                    gems=gems+8000,
                    coins=coins+100000,
                    energy=30,
                    energy_updated=?
                WHERE uid=?
                """,
                (new_gram, int(time.time()), uid)
            )

            reward = {
                "gems": 8000,
                "coins": 100000,
                "energy": 30
            }

        else:
            c.rollback()
            return {"error": "Unsupported product"}

        # Transaction history.
        c.execute(
            """
            INSERT INTO shop_purchases(uid,product_id,gram_spent,created_at)
            VALUES(?,?,?,?)
            """,
            (uid, product_id, price, int(time.time()))
        )

        c.commit()

        final_user = c.execute(
            "SELECT * FROM users WHERE uid=?",
            (uid,)
        ).fetchone()

        return {
            "success": True,
            "product": product_id,
            "gram": final_user["gram"],
            "gems": final_user["gems"],
            "coins": final_user["coins"],
            "energy": final_user["energy"],
            "reward": reward
        }

    except Exception as e:
        c.rollback()
        return {"error": str(e)}

    finally:
        c.close()

def do_battle(uid, mission):
